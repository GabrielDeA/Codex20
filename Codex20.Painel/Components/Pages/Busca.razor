@page "/busca"
@using Codex20.Core.Busca
@using Codex20.Core.Embeddings
@inject ServicoEmbeddings ServicoEmbeddings
@inject ServicoBusca ServicoBusca

<PageTitle>Busca · Codex20</PageTitle>

<h1>Busca</h1>

@if (!ServicoEmbeddings.IsConfigurado)
{
    <div class="alerta aviso">
        @ServicoEmbeddings.ErroConfiguracao<br />
        Sem as credenciais só a busca BM25 funciona. O Painel lê os mesmos user-secrets do Embeddings.Playground — veja <code>Codex20.Embeddings/README.md</code> e reinicie o Painel.
    </div>
}

<form class="barra" @onsubmit="Buscar">
    <label class="expande">
        Consulta
        <input type="search" placeholder="ex.: pontos de vida do aarakocra" @bind="consulta" @bind:event="oninput" />
    </label>
    <label>
        Estratégia
        <select @bind="nomeEstrategia" disabled="@(isBuscando || isCompararTodas)">
            @foreach (IEstrategiaBusca opcao in ServicoBusca.Estrategias)
            {
                <option value="@opcao.Nome" disabled="@(!opcao.IsDisponivel)" title="@opcao.MotivoIndisponivel">@opcao.NomeExibicao</option>
            }
        </select>
    </label>
    <label>
        Resultados
        <input type="number" min="1" max="50" class="numero" @bind="top" />
    </label>
    <label class="linha">
        <input type="checkbox" @bind="isCompararTodas" disabled="@isBuscando" />
        Comparar todas
    </label>
    <button type="submit" class="primario" disabled="@(isBuscando || !IsPodeBuscar())">
        @(isBuscando ? "Buscando…" : "Buscar")
    </button>
</form>

@if (isCompararTodas)
{
    <p class="nota">
        Roda todas as estratégias sobre a mesma consulta, uma de cada vez, e mostra os rankings lado a lado.
        A primeira consulta paga o cache frio do banco — rode uma de aquecimento antes de anotar tempos.
    </p>
}
else
{
    <p class="nota">Busca no banco inteiro (os três livros). @ServicoBusca.Obter(nomeEstrategia).Descricao</p>
}

@if (erro is not null)
{
    <div class="alerta erro">@erro</div>
}

@if (respostas.Count > 0 && isComparacaoFeita)
{
    <p class="nota">Comparação para “@consultaFeita”</p>

    <div class="comparacao">
        @foreach (RespostaBusca resposta in respostas)
        {
            <section class="coluna-estrategia">
                <header>
                    <strong>@ServicoBusca.Obter(resposta.NomeEstrategia).NomeExibicao</strong>
                    <span class="tempo">@FormatarDuracao(resposta)</span>
                    <span class="suave">@resposta.Resultados.Count resultado(s)</span>
                </header>
                @if (resposta.Observacao is not null)
                {
                    <div class="alerta aviso">@resposta.Observacao</div>
                }
                @foreach (ResultadoBusca achado in resposta.Resultados)
                {
                    <CartaoChunk Chunk="achado.Chunk" Pontuacao="achado.Pontuacao" RotuloPontuacao="@resposta.RotuloPontuacao"
                                 DetalhePontuacao="@FormatoChunk.Contribuicoes(achado)" Posicao="achado.Posicao" IsCompacto="true" />
                }
            </section>
        }
    </div>
}
else if (respostas.Count > 0)
{
    RespostaBusca resposta = respostas[0];

    <p class="nota">
        @resposta.Resultados.Count resultado(s) para “@consultaFeita” · @ServicoBusca.Obter(resposta.NomeEstrategia).NomeExibicao · @FormatarDuracao(resposta)
        @if (ServicoEmbeddings.IsConfigurado)
        {
            <text> · modelo <code>@ServicoEmbeddings.Modelo</code></text>
        }
    </p>

    @if (resposta.Observacao is not null)
    {
        <div class="alerta aviso">@resposta.Observacao</div>
    }

    @foreach (ResultadoBusca achado in resposta.Resultados)
    {
        <CartaoChunk Chunk="achado.Chunk" Pontuacao="achado.Pontuacao" RotuloPontuacao="@resposta.RotuloPontuacao"
                     DetalhePontuacao="@FormatoChunk.Contribuicoes(achado)" Posicao="achado.Posicao" IsCompacto="true" />
    }
}

@code {
    private string consulta = string.Empty;
    private string consultaFeita = string.Empty;
    private string nomeEstrategia = string.Empty;
    private int top = 5;
    private bool isCompararTodas;
    private bool isComparacaoFeita;
    private bool isBuscando;
    private string? erro;
    private List<RespostaBusca> respostas = new();

    protected override void OnInitialized()
    {
        // Sem credenciais a vetorial nasce desabilitada; começar por ela deixaria o botão travado.
        nomeEstrategia = ServicoBusca.Estrategias[0].Nome;
        foreach (IEstrategiaBusca estrategia in ServicoBusca.Estrategias)
        {
            if (estrategia.IsDisponivel)
            {
                nomeEstrategia = estrategia.Nome;
                break;
            }
        }
    }

    private bool IsPodeBuscar()
    {
        if (!isCompararTodas)
        {
            return ServicoBusca.Obter(nomeEstrategia).IsDisponivel;
        }

        foreach (IEstrategiaBusca estrategia in ServicoBusca.Estrategias)
        {
            if (estrategia.IsDisponivel)
            {
                return true;
            }
        }

        return false;
    }

    private async Task Buscar()
    {
        if (string.IsNullOrWhiteSpace(consulta) || isBuscando || !IsPodeBuscar())
        {
            return;
        }

        erro = null;
        isBuscando = true;
        var pedido = new PedidoBusca { Texto = consulta.Trim(), Quantidade = Math.Clamp(top, 1, 50) };

        try
        {
            if (isCompararTodas)
            {
                respostas = await ServicoBusca.CompararAsync(pedido);
            }
            else
            {
                respostas = new List<RespostaBusca> { await ServicoBusca.ExecutarAsync(nomeEstrategia, pedido) };
            }

            isComparacaoFeita = isCompararTodas;
            consultaFeita = pedido.Texto;
        }
        catch (Exception excecao)
        {
            erro = excecao.Message;
        }
        finally
        {
            isBuscando = false;
        }
    }

    private static string FormatarDuracao(RespostaBusca resposta)
    {
        return $"{resposta.Duracao.TotalMilliseconds:N1} ms";
    }
}
