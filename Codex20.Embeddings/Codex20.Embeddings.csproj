<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Codex20.Embeddings</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Codex20.Core\Codex20.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Azure.AI.OpenAI" Version="2.1.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.11" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.10" />
    <!-- Traz o vec0 nativo e o LoadVector(). -->
    <PackageReference Include="sqlite-vec" Version="0.1.7-alpha.2.1" />
    <!-- Sobe a versão que o Microsoft.Data.Sqlite traz por transitividade (2.1.10 tem CVE conhecido). -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
  </ItemGroup>

</Project>
