    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Mesmo Id do Painel e do Embeddings.Playground: lê as mesmas credenciais do Azure OpenAI. -->
    <UserSecretsId>3f0b4c5a-7d18-4a92-9f6b-2c8e1d4a5b70</UserSecretsId>
